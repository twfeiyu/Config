#!name=淨化B站(去直播+去開屏)
#!desc=深度屏蔽B站直播頁籤、直播間與開屏廣告

[Rule]
# === 屏蔽直播核心與追蹤網域 ===
DOMAIN-SUFFIX,api.live.bilibili.com,REJECT
DOMAIN-SUFFIX,live-trace.bilibili.com,REJECT
DOMAIN-SUFFIX,live-push.bilibili.com,REJECT
DOMAIN-SUFFIX,live.bilibili.com,REJECT

# === 屏蔽直播流與廣告追蹤關鍵字 ===
DOMAIN-KEYWORD,live-play,REJECT
DOMAIN-KEYWORD,live-bvc,REJECT
DOMAIN,cm.bilibili.com,REJECT

https://ahrefs.com/writing-tools/paragraph-rewriter
# === 新增：屏蔽開屏廣告 ===
# 攔截各類閃屏/開屏廣告 API，直接返回空 JSON 秒進首頁
^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/.* reject-dict
^https?:\/\/api\.bilibili\.com\/x\/v2\/splash\/.* reject-dict
^https?:\/\/app\.bilibili\.com\/bilibili\.app\.show\.v1\.Splash\/.* reject-dict

# === 原有：屏蔽直播相關 ===
# 1. 屏蔽 App 首頁的直播頁籤與推薦流 (返回空 JSON 防轉圈)
^https?:\/\/app\.bilibili\.com\/x\/v2\/show\/live\/.* reject-dict
^https?:\/\/api\.live\.bilibili\.com\/xlive\/.* reject-dict

# 2. 屏蔽 Web 端導覽列與直播介面
^https?:\/\/api\.bilibili\.com\/x\/web-interface\/nav reject-dict

# 3. 徹底屏蔽直播間視訊流
^https?:\/\/.*\/live-bvc\/.* reject-200
^https?:\/\/.*\/live-play\/.* reject-200

# 4. 屏蔽直播彈幕與 WebSocket 連線
^https?:\/\/broadcast\.chat\.bilibili\.com\/.* reject-200

[MITM]
# 必須設定 MITM 才能成功解密並攔截
hostname = %APPEND% api.live.bilibili.com, app.bilibili.com, api.bilibili.com, broadcast.chat.bilibili.com, cm.bilibili.com
